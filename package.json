{
  "name": "pwd-book",
  "version": "1.0.0",
  "description": "PwdBook - local password manager desktop app",
  "author": "PwdBook",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/generate-icons.mjs",
    "predist": "npm run icons",
    "predist:win": "npm run icons",
    "predist:win:dir": "npm run icons",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:dir": "npm run build && electron-builder --win --dir",
    "screenshots:animal": "node scripts/capture-animal-screenshots.mjs"
  },
  "build": {
    "appId": "com.pwdbook.app",
    "productName": "PwdBook",
    "copyright": "Copyright © 2026 PwdBook",
    "directories": {
      "output": "release",
      "buildResources": "icon"
    },
    "icon": "icon.png",
    "afterPack": "scripts/after-pack.mjs",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": "icon/icon.png",
        "to": "icon.png"
      },
      {
        "from": "icon/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PwdBook",
      "include": "deps/installer.nsh"
    }
  },
  "dependencies": {
    "animal-island-vue": "^0.1.3",
    "archiver": "7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "lucide-vue-next": "^0.511.0",
    "nodemailer": "^8.0.10",
    "sql.js": "^1.14.1",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vue-tsc": "^2.2.8"
  }
}
